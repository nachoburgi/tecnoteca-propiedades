# Proveedor: openai (formato /chat/completions con tools) | anthropic (formato /v1/messages con tool_use) | mock (sin IA, para probar)
AI_PROVIDER=openai
# URL base. openai: https://api.openai.com/v1  ·  anthropic: https://api.anthropic.com
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
PORT=3000

# Número de WhatsApp de la inmobiliaria (con código de país, ej 5493415551234). Vacío = WhatsApp elige contacto.
WHATSAPP_NUMERO=
